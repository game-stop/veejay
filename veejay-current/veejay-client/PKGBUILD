# Modified for ArchLinux by Niels <nwelburg@gmail.com>
pkgname=veejay-client
pkgrel=1
pkgver=1.6.0
_veejay_arch_target=generic
_source_name=reloaded
pkgdesc="Reloaded is the graphical user interface for Veejay"
arch=('x86_64' 'armv7h' 'aarch64' 'powerpc' 'powerpc64' 'powerpc64le')
url="http://www.veejayhq.net"
license=('GPL2')
groups=()
conflicts=('reloaded')
provides=('reloaded')
depends=('veejay-core' 'gtk3' 'libx11' 'sdl2' 'ffmpeg' 'alsa-lib')
optdepends=('veejay: to control a local veejay backend')
makedepends=('pkgconf')
source=("${_source_name}-${pkgver}.tar.gz")
sha256sums=('SKIP')
backup=()
replaces=()

build() {
	export PKG_CONFIG_PATH=/usr/lib/pkgconfig
	cd "$srcdir/${_source_name}-${pkgver}"
  ./autogen.sh
	./configure --prefix=/usr --with-arch-target="$_veejay_arch_target"
  make || return 1
}

package() {
	cd "$srcdir/${_source_name}-${pkgver}"
	make DESTDIR="$pkgdir/" install
}

