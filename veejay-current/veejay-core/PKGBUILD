# Contributor: Niels Elburg <nwelburg@gmail.com>
pkgname=veejay-core
pkgrel=1
pkgver=1.6.0
_veejay_arch_target=generic
_source_name=veejaycore
pkgdesc="Core runtime library shared by the Veejay video tools"
arch=('x86_64' 'armv7h' 'aarch64' 'powerpc' 'powerpc64' 'powerpc64le')
url="http://www.veejayhq.net"
license=('GPL2')
groups=()
conflicts=('veejay-core')
depends=('glib2' 'ffmpeg')
optdepends=()
makedepends=('pkgconf')
source=("${_source_name}-${pkgver}.tar.gz")
sha256sums=('SKIP')
backup=()
replaces=()

build() {
	cd "$srcdir/${_source_name}-${pkgver}"
	./autogen.sh
	./configure --prefix=/usr --with-arch-target="$_veejay_arch_target"
	make || return 1
}

package() {
	cd "$srcdir/${_source_name}-${pkgver}"
	make DESTDIR="$pkgdir/" install
}
