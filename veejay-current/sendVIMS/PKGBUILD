# Contributor: Niels Elburg <nwelburg@gmail.com>
pkgname=veejay-puredata
pkgrel=1
pkgver=1.6.0
pkgdesc="Pure Data external for controlling Veejay via VIMS"
arch=('x86_64' 'armv7h' 'aarch64' 'powerpc' 'powerpc64' 'powerpc64le')
url="http://www.veejayhq.net"
license=('GPL2')
groups=()
conflicts=('veejay-sayvims')
provides=('veejay-sayvims')
replaces=('veejay-sayvims')
depends=('puredata')
optdepends=('veejay: to control a local veejay backend')
makedepends=('perl')
source=("${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')
backup=()

build() {
	cd "$srcdir/${pkgname}-${pkgver}"
	./configure --prefix=/usr
	make PDINCLUDE=/usr/include/pd || return 1
}

package() {
	cd "$srcdir/${pkgname}-${pkgver}"
	make DESTDIR="$pkgdir/" PREFIX=/usr PDINCLUDE=/usr/include/pd install
}
