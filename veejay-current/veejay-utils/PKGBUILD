# Modified for ArchLinux by Niels <nwelburg@gmail.com>
pkgname=veejay-utils
pkgrel=1
pkgver=1.6.0
pkgdesc="Additional command line utilities for veejay (sayVIMS)"
arch=('x86_64' 'aarch64')
url="http://www.veejayhq.net"
license=('GPL2')
groups=()
conflicts=('sayVIMS')
provides=('sayVIMS')
depends=('veejay-core' 'veejay' 'ffmpeg')
optdepends=()
makedepends=('pkgconf')
source=()
md5sums=()
changelog=ChangeLog
backup=()
replaces=()

build() {
	export PKG_CONFIG_PATH=/usr/lib/pkgconfig
	cd $startdir
  ./autogen.sh
  ./configure --prefix=/usr
  make || return 1
}

package() {
	cd $startdir
	make DESTDIR="$pkgdir/" install
}

