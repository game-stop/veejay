pkgname=veejay-eidolon
pkgrel=1
pkgver=1.6.0
pkgdesc="eidolon is a generative/life-simulation frame source for veejay"
arch=('x86_64' 'aarch64')
url="http://www.veejayhq.net"
license=('GPL2')
groups=()
conflicts=('veejay-eidolon')
depends=('veejay-core' 'ffmpeg')
optdepends=()
makedepends=('pkgconf')
source=()
md5sums=()
changelog=ChangeLog
backup=()
replaces=()

build() {
	export PKG_CONFIG_PATH=/usr/lib/pkgconfig
	cd $startdir
  ./autogen.sh
  ./configure --prefix=/usr
  make || return 1
}

package() {
	cd $startdir
	make DESTDIR="$pkgdir/" install
}

