#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1

# This has to be exported to make some magic below work.
export DH_OPTIONS
VEEJAY_ARCH_TARGET ?= generic
VEEJAY_NVJPEG_CONFIGURE ?= --with-nvjpeg=no
ifneq ($(wildcard debian/veejay-release.mk),)
include debian/veejay-release.mk
endif


%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- --with-arch-target=$(VEEJAY_ARCH_TARGET) $(VEEJAY_NVJPEG_CONFIGURE)

# NDI support is dlopen()'d at runtime (NDI_LIBS is just -ldl), so it never
# creates a dpkg-shlibdeps problem; only the SDK header is needed at build
# time. The SDK ships outside any standard include path and its install
# location has no portable build-time convention, so plain configure
# "auto" (system include paths only) leaves it disabled by default. To
# build with NDI support on a host that has the SDK installed, add an
# override_dh_auto_configure target here that runs
# `dh_auto_configure -- --with-ndi=/path/to/sdk`.
# Note: NDI_RUNTIME_DIR_V6 (as named by this SDK's own header) is a
# runtime-only variable the NDI library reads via dlopen() to locate
# libndi.so.6; it is unrelated to locating headers at build time.

# Release builds default to a CUDA-neutral server. The release workflow writes
# --with-nvjpeg=yes to veejay-release.mk for the explicit -nvjpeg variant and
# verifies both the configure result and packaged ELF dependencies. libnvjpeg
# can lack Debian shlibs metadata, so do not fail dependency generation solely
# because that optional vendor library has no distro-owned package record.
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
