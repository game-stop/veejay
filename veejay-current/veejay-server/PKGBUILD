# Modified for ArchLinux by Niels <nwelburg@gmail.com>
pkgname=veejay
pkgrel=1
pkgver=1.6.0
pkgdesc="Veejay is a visual instrument and realtime video sampler for GNU/Linux, server"
arch=('x86_64' 'aarch64')
url="http://www.veejayhq.net"
license=('GPL2')
groups=()
conflicts=('veejay')
depends=('veejay-core' 'glib2' 'ffmpeg' 'libxml2' 'freetype2' 'fontconfig' 'sdl2' 'libunwind' 'libx11' 'libxinerama' 'libjpeg-turbo' 'gdk-pixbuf2')
optdepends=('liblo: OSC control support' 'libdv: DV capture/playback' 'libquicktime: Quicktime file support' 'jack2: JACK audio output' 'cuda: nvJPEG hardware MJPEG decode')
makedepends=('pkgconf')
source=()
md5sums=()
backup=()
replaces=()

build() {
	cd $startdir
	./autogen.sh
	./configure --prefix=/usr
	make || return 1
}

package() {
	cd $startdir
	make DESTDIR="$pkgdir/" install
}

